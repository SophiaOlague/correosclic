//ConfiguraciónSistema

model ConfiguracionSistema {

  id String
    @id
    @default(uuid())
    @db.Uuid

  clave String
    @unique
    @db.VarChar(100)

  valor String
    @db.Text

  descripcion String?
    @db.Text

  createdAt DateTime
    @default(now())

  updatedAt DateTime
    @updatedAt

  @@map("configuraciones_sistema")
}

//Auditoria

model Auditoria {

  id String
    @id
    @default(uuid())
    @db.Uuid

  usuarioId String?
    @db.Uuid

  accion String
    @db.VarChar(100)

  entidad String
    @db.VarChar(100)

  entidadId String?
    @db.Uuid

  detalles String?
    @db.Text

  ipAddress String?
    @db.VarChar(100)

  createdAt DateTime
    @default(now())

  usuario Usuario?
    @relation(
      fields: [usuarioId],
      references: [id]
    )

  @@index([usuarioId])

  @@index([accion])

  @@index([entidad])

  @@index([createdAt])

  @@map("auditoria")
}
