# URL base de la API de CorreosClic. Incluye el prefijo global `/api`
# que el backend fija en apps/backend/src/main.ts.
VITE_API_URL=http://localhost:3000/api

# Clave publicable de Stripe (pk_test_... en desarrollo).
# Debe pertenecer a la misma cuenta que STRIPE_SECRET_KEY del backend.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_CAMBIAR
